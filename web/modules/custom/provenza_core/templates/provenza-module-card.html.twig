<article class="provenza-module-card">
  <p class="provenza-kicker">{{ category }}</p>
  {% if image %}
    <p class="provenza-module-card__shot"><img src="{{ image }}" alt="Dónde se ve {{ title }} en este sitio" /></p>
  {% endif %}
  <h2><a href="{{ url }}">{{ title }}</a></h2>
  <p>{{ summary }}</p>
</article>
