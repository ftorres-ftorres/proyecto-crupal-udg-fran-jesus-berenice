<div class="inicio-app">
  <section class="hola">
    <div>
      <p class="hola__fecha">{{ fecha_hoy }}</p>
      <h1 class="hola__titulo">{{ saludo }}, <em>{{ nombre }}</em></h1>
      {% if casa %}<p class="hola__casa">{{ source('@provenza/icons/casa.svg') }}{{ casa }}</p>{% endif %}
    </div>
  </section>

  <section class="apps" aria-label="Nuevo trámite">
    {% for a in acciones %}
      <a class="app-icono" href="{{ a.url }}">
        <span class="app-icono__forma">{{ source('@provenza/icons/' ~ a.icono ~ '.svg') }}</span>
        <span class="app-icono__nombre">{{ a.titulo }}</span>
      </a>
    {% endfor %}
  </section>

  <div class="widgets">
    <section class="widget widget--olivo widget--reserva" aria-labelledby="w-reserva">
      <div class="widget__cabeza"><h2 id="w-reserva">Próxima reservación</h2>{{ source('@provenza/icons/fiesta.svg') }}</div>
      {% if reservacion %}
        <a class="reserva-w" href="{{ reservacion.url }}">
          <span class="reserva-w__dia">{{ reservacion.dia }}</span>
          <span class="reserva-w__info">
            <strong>{{ reservacion.titulo }}</strong>
            {% set partes = reservacion.hora|split(', ') %}<span>{{ partes|first }} {{ reservacion.dia }} de {{ reservacion.mes|lower }}, {{ partes|last }}</span>
            {% if reservacion.invitados %}<span>{{ reservacion.invitados }} invitados</span>{% endif %}
          </span>
        </a>
        <span class="pildora pildora--clara">{{ reservacion.estado_texto }}</span>
      {% else %}
        <p>No tienes reservaciones próximas.</p>
        <a class="pildora pildora--clara" href="/instalaciones/salon-de-fiestas/calendario">Ver fechas libres</a>
      {% endif %}
    </section>

    <section class="widget widget--semana" aria-labelledby="w-semana">
      <div class="widget__cabeza"><h2 id="w-semana">Esta semana</h2><a class="flecha-circulo" href="/comunidad/calendario" aria-label="Ver calendario">{{ source('@provenza/icons/flecha_diag.svg') }}</a></div>
      <div class="semana">
        {% for d in semana %}
          <span class="semana__dia{{ d.hoy ? ' es-hoy' }}{{ d.evento ? ' con-evento' }}"><small>{{ d.nombre }}</small><strong>{{ d.numero }}</strong></span>
        {% endfor %}
      </div>
      {% for e in eventos_semana|slice(0, 2) %}
        <a class="semana__evento" href="{{ e.url }}"><strong>{{ e.titulo }}</strong><span>{{ e.semana }}, {{ e.hora }}</span></a>
      {% else %}
        <p class="widget__vacio">Sin eventos en los próximos siete días.</p>
      {% endfor %}
    </section>

    <section class="widget widget--negro widget--pases" aria-labelledby="w-pases">
      <div class="widget__cabeza"><h2 id="w-pases">Pases de visita</h2>{{ source('@provenza/icons/qr.svg') }}</div>
      {% for p in pases %}
        <a class="pase-w" href="{{ p.url }}"><strong>{{ p.nombre }}</strong><span>{{ p.ventana }}</span></a>
      {% else %}
        <p>No tienes pases vigentes.</p>
      {% endfor %}
      <a class="pildora pildora--clara" href="/form/registrar-visita">Nuevo pase</a>
    </section>

    <section class="widget widget--tramites" aria-labelledby="w-tramites">
      <div class="widget__cabeza"><h2 id="w-tramites">Trámites recientes</h2><a class="flecha-circulo" href="/solicitudes/mis-solicitudes" aria-label="Ver solicitudes">{{ source('@provenza/icons/flecha_diag.svg') }}</a></div>
      {% if recientes %}
        <ul class="filas">
          {% for r in recientes %}
            <li>
              <a href="{{ r.url }}">
                <span class="filas__icono">{{ source('@provenza/icons/' ~ (r.tipo == 'Solicitud' ? 'solicitud' : (r.tipo == 'Queja' ? 'queja' : (r.tipo == 'Visita' ? 'qr' : 'calendario'))) ~ '.svg') }}</span>
                <span class="filas__info"><strong>{{ r.titulo }}</strong><span>{{ r.tipo }}{% if r.folio %}, {{ r.folio }}{% endif %}</span></span>
                <span class="estado estado--{{ r.estado }}">{{ r.estado_texto }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="widget__vacio">Todavía no tienes trámites.</p>
      {% endif %}
    </section>

    <section class="widget widget--avisos" aria-labelledby="w-avisos">
      <div class="widget__cabeza"><h2 id="w-avisos">Avisos</h2><a class="flecha-circulo" href="/comunidad/avisos" aria-label="Todos los avisos">{{ source('@provenza/icons/flecha_diag.svg') }}</a></div>
      {% for a in avisos %}
        <a class="aviso-w" href="{{ a.url }}">{% if a.urgente %}<span class="pildora pildora--negra">Urgente</span>{% endif %}<span>{{ a.titulo }}</span></a>
      {% endfor %}
    </section>
  </div>
</div>
