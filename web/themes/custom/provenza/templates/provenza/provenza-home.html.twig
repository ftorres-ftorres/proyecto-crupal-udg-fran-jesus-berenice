{#
  Secciones de la portada debajo del hero (el hero vive en page--front).
#}
{% if instalaciones %}
<section class="seccion seccion--tono" aria-labelledby="inst-titulo">
  <div class="contenedor">
    <div class="seccion__cabeza seccion__cabeza--fila revela">
      <h2 id="inst-titulo">Espacios para <em>todos</em></h2>
      <a class="boton boton--oscuro" href="/instalaciones">Ver instalaciones{{ source('@provenza/icons/flecha.svg') }}</a>
    </div>
    <div class="galeria" data-galeria>
      {% for i in instalaciones %}
        <a class="galeria__panel{{ loop.first ? ' es-activo' }}" href="{{ i.url }}">
          <span class="galeria__medio"><img src="{{ i.foto }}" alt="{{ i.titulo }} de Provenza Residencial" loading="lazy" width="1200" height="900"><span class="galeria__velo"></span></span>
          <span class="galeria__vertical" aria-hidden="true">{{ i.titulo }}</span>
          <span class="galeria__info">
            <span class="galeria__titulo">{{ i.titulo }}</span>
            {% if i.descripcion %}<span class="galeria__texto">{{ i.descripcion }}</span>{% endif %}
            <span class="galeria__datos">
              {% if i.horario %}<span>{{ source('@provenza/icons/reloj.svg') }}{{ i.horario }}</span>{% endif %}
              {% if i.capacidad %}<span>{{ source('@provenza/icons/grupo.svg') }}Hasta {{ i.capacidad }} personas</span>{% endif %}
            </span>
          </span>
          <span class="muesca muesca--galeria" aria-hidden="true"><span>{{ source('@provenza/icons/flecha_diag.svg') }}</span></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="agenda" aria-labelledby="agenda-titulo">
  <div class="muesca muesca--sup-izq muesca--agenda"><h2 id="agenda-titulo">La vida en <em>Provenza</em></h2></div>
  <div class="agenda__rejilla">
    {% set principal = avisos|first %}
    {% if principal %}
      <a class="aviso-destacado revela" href="{{ principal.url }}">
        <span class="aviso-destacado__medio"><img src="{{ principal.foto }}" alt="" loading="lazy" width="1200" height="900"><span class="aviso-destacado__velo"></span></span>
        <span class="aviso-destacado__cuerpo">
          <span class="aviso-destacado__titulo">{{ principal.titulo }}</span>
          {% if principal.resumen %}<span class="aviso-destacado__texto">{{ principal.resumen }}</span>{% endif %}
          <span class="aviso-destacado__meta">Publicado el {{ principal.fecha|lower }}</span>
        </span>
        <span class="muesca muesca--flecha" aria-hidden="true"><span>{{ source('@provenza/icons/flecha_diag.svg') }}</span></span>
      </a>
    {% endif %}
    <div class="agenda__lado revela" style="--retraso: 120ms">
      <ol class="agenda__lista">
        {% for e in eventos %}
          <li>
            <a href="{{ e.url }}">
              <img class="agenda__foto" src="{{ e.foto }}" alt="" loading="lazy" width="112" height="84">
              <span class="agenda__dia">{{ e.dia }}</span>
              <span class="agenda__mes">{{ e.mes }}</span>
              <span class="agenda__info"><span class="agenda__titulo">{{ e.titulo }}</span><span class="agenda__hora">{{ e.hora }}{% if e.lugar %}, {{ e.lugar }}{% endif %}</span></span>
              <span class="agenda__flecha">{{ source('@provenza/icons/flecha.svg') }}</span>
            </a>
          </li>
        {% endfor %}
      </ol>
      {% if avisos|length > 1 %}
        <div class="agenda__mas">
          {% for a in avisos|slice(1) %}<a href="{{ a.url }}">{{ a.titulo }}</a>{% endfor %}
        </div>
      {% endif %}
      <div class="agenda__enlaces">
        <a class="boton boton--claro" href="/comunidad/calendario">Ver calendario{{ source('@provenza/icons/flecha.svg') }}</a>
        <a class="boton boton--vidrio vidrio" href="/comunidad/avisos">Todos los avisos</a>
      </div>
    </div>
  </div>
</section>
