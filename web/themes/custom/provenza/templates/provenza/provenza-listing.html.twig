{#
  Listados públicos con un diseño distinto por tipo de contenido.
#}
<div class="listado listado--{{ bundle }}">
  {% if intro %}<p class="listado__intro">{{ intro }}</p>{% endif %}

  {% if not items %}
    <div class="vacio">
      <span class="vacio__icono">{{ source('@provenza/icons/documento.svg') }}</span>
      <p>Todavía no hay contenidos en esta sección.</p>
    </div>

  {% elseif bundle == 'instalacion' %}
    <div class="rejilla-fotos rejilla-fotos--listado">
      {% for i in items %}
        <a class="foto-tarjeta foto-tarjeta--alta cortina" href="{{ i.url }}" style="--retraso: {{ (loop.index0 % 4) * 110 }}ms">
          <img src="{{ i.foto }}" alt="{{ i.titulo }}" loading="lazy" width="640" height="480">
          <span class="foto-tarjeta__pie">
            <span class="foto-tarjeta__titulo">{{ i.titulo }}</span>
            {% if i.resumen %}<span class="foto-tarjeta__texto">{{ i.resumen }}</span>{% endif %}
            <span class="foto-tarjeta__datos">
              <span class="foto-tarjeta__dato">{{ source('@provenza/icons/reloj.svg') }}<span>{{ i.horario }}</span></span>
              {% if i.capacidad %}<span class="foto-tarjeta__dato">{{ source('@provenza/icons/grupo.svg') }}<span>Hasta {{ i.capacidad }}</span></span>{% endif %}
            </span>
          </span>
        </a>
      {% endfor %}
    </div>

  {% elseif bundle == 'tarifa' %}
    <div class="tarifas">
      {% for t in items %}
        <div class="tarifa revela" style="--retraso: {{ loop.index0 * 40 }}ms">
          <span class="tarifa__concepto">{{ t.titulo }}</span>
          <span class="tarifa__monto"><small>$</small>{{ t.monto }}<small>MXN</small></span>
        </div>
      {% endfor %}
    </div>
    <p class="nota">{{ source('@provenza/icons/ayuda.svg') }}Los pagos se hacen directamente con Administración. El portal publica los montos para que todas las casas tengan la misma información.</p>

  {% elseif bundle == 'faq' %}
    <div class="acordeon">
      {% for f in items %}
        <details class="acordeon__item revela"{% if loop.first %} open{% endif %}>
          <summary>{{ f.titulo }}</summary>
          <div class="acordeon__cuerpo">{{ f.cuerpo }}</div>
        </details>
      {% endfor %}
    </div>

  {% elseif bundle == 'evento' %}
    {% set d = calendario.destacado %}
    {% if d %}
      <a class="evento-destacado revela" href="{{ d.url }}">
        <span class="evento-destacado__medio"><img src="{{ d.foto }}" alt="" width="1200" height="900"><span class="evento-destacado__velo"></span></span>
        <span class="evento-destacado__fecha"><strong>{{ d.dia }}</strong>{{ d.mes }}</span>
        <span class="evento-destacado__cuerpo">
          <span class="evento-destacado__cuando">{{ d.cuando }}</span>
          <span class="evento-destacado__titulo">{{ d.titulo }}</span>
          <span class="evento-destacado__datos">{{ d.semana }} {{ d.dia }} de {{ d.mes_largo }}, {{ d.hora }}{% if d.lugar %}, {{ d.lugar }}{% endif %}</span>
        </span>
        <span class="muesca muesca--evento" aria-hidden="true"><span>{{ source('@provenza/icons/flecha_diag.svg') }}</span></span>
      </a>
    {% endif %}
    <div class="calendario">
      <section class="mes" aria-label="{{ calendario.mes.titulo }}">
        <div class="mes__cabeza">
          <h2>{{ calendario.mes.titulo }}</h2>
          <div class="mes__nav">
            <a class="icono-boton" href="?mes={{ calendario.mes.anterior }}" aria-label="Mes anterior"><span class="mes__atras">{{ source('@provenza/icons/flecha.svg') }}</span></a>
            <a class="icono-boton" href="?mes={{ calendario.mes.siguiente }}" aria-label="Mes siguiente">{{ source('@provenza/icons/flecha.svg') }}</a>
          </div>
        </div>
        <div class="mes__rejilla">
          {% for s in ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'] %}<span class="mes__semana">{{ s }}</span>{% endfor %}
          {% for c in calendario.mes.celdas %}
            {% if c.vacio %}
              <span class="mes__dia mes__dia--vacio"></span>
            {% elseif c.eventos %}
              {% set e = c.eventos|first %}
              <a class="mes__dia mes__dia--evento{{ c.hoy ? ' es-hoy' }}" href="{{ e.url }}" title="{{ e.titulo }}" style="--foto: url('{{ e.foto }}')">
                <span class="mes__numero">{{ c.dia }}</span>
                <span class="mes__nombre">{{ e.titulo }}</span>
              </a>
            {% else %}
              <span class="mes__dia{{ c.hoy ? ' es-hoy' }}"><span class="mes__numero">{{ c.dia }}</span></span>
            {% endif %}
          {% endfor %}
        </div>
      </section>
      <aside class="calendario__lado">
        {% include '@provenza/content/_proximas.html.twig' with { proximos: calendario.proximos, id: 'calendario' } %}
      </aside>
    </div>
  {% elseif bundle == 'directorio' %}
    <div class="contactos">
      {% for c in items %}
        <div class="contacto revela">
          <span class="contacto__icono">{{ source('@provenza/icons/telefono.svg') }}</span>
          <h2 class="contacto__nombre">{{ c.titulo }}</h2>
          {% if c.resumen %}<p>{{ c.resumen }}</p>{% endif %}
          <div class="contacto__acciones">
            {% if c.telefono %}<a class="boton boton--chico" href="tel:{{ c.telefono|replace({' ': ''}) }}">{{ source('@provenza/icons/telefono.svg') }}{{ c.telefono }}</a>{% endif %}
            {% if c.correo %}<a class="boton boton--chico boton--claro" href="mailto:{{ c.correo }}">{{ source('@provenza/icons/correo.svg') }}Correo</a>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  {% elseif bundle == 'documento' %}
    <div class="documentos">
      {% for d in items %}
        <a class="documento revela" href="{{ d.archivo ?: d.url }}">
          <span class="documento__icono">{{ source('@provenza/icons/documento.svg') }}</span>
          <span class="documento__info">
            <span class="documento__titulo">{{ d.titulo }}</span>
            <span class="documento__meta">{{ d.tipo }}{% if d.tipo %}, {% endif %}{{ d.fecha }}</span>
          </span>
          <span class="documento__flecha">{{ source('@provenza/icons/flecha_diag.svg') }}</span>
        </a>
      {% endfor %}
    </div>

  {% else %}
    <div class="tarjetas">
      {% for a in items %}
        <a class="tarjeta revela{{ a.urgente ? ' tarjeta--urgente' }}" href="{{ a.url }}" style="--retraso: {{ (loop.index0 % 3) * 60 }}ms">
          <span class="tarjeta__titulo">{{ a.titulo }}</span>
          {% if a.resumen %}<span class="tarjeta__texto">{{ a.resumen }}</span>{% endif %}
          <span class="tarjeta__meta">
            {% if a.urgente %}<span class="etiqueta etiqueta--acento">Urgente</span>{% endif %}
            {% if a.categoria %}<span class="etiqueta">{{ a.categoria }}</span>{% endif %}
            <span>{{ a.fecha }}</span>
          </span>
          <span class="enlace-flecha">Leer{{ source('@provenza/icons/flecha.svg') }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>
