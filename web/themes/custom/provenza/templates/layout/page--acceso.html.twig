{% include '@provenza/layout/_vidrio.html.twig' %}
<div class="acceso">
  <div class="acceso__form">
    <a class="acceso__volver" href="{{ path('<front>') }}">{{ source('@provenza/icons/flecha.svg') }}Volver al sitio</a>
    <div class="acceso__caja">
      {% include '@provenza/layout/_marca.html.twig' %}
      <h1>{{ acceso_titulo }}</h1>
      <p class="acceso__texto">{{ acceso_texto }}</p>
      {{ page.highlighted }}
      {{ page.content }}
      <p class="acceso__alterno">
        {% if acceso_ruta == 'user.login' %}
          ¿Aún no tienes cuenta? <a href="{{ path('user.register') }}">Solicita tu alta</a>
        {% else %}
          ¿Ya tienes cuenta? <a href="{{ url_entrar }}">Inicia sesión</a>
        {% endif %}
      </p>
    </div>
  </div>
  <div class="acceso__visual">
    <div class="acceso__medio">
      <video autoplay muted loop playsinline preload="metadata" poster="{{ poster_hero }}"><source src="{{ video_hero }}" type="video/mp4"></video>
      <div class="acceso__velo"></div>
    </div>
    <span class="acceso__corte acceso__corte--sup" aria-hidden="true"></span>
    <span class="acceso__corte acceso__corte--inf" aria-hidden="true"></span>
    <p class="acceso__frase">Tu comunidad, sus espacios y tus trámites en un solo lugar.</p>
  </div>
</div>
