<a href="#contenido" class="visually-hidden focusable saltar">Saltar al contenido</a>
{% include '@provenza/layout/_alerta.html.twig' %}
{% include '@provenza/layout/_vidrio.html.twig' %}
{% include '@provenza/layout/_barra.html.twig' with { fija: false } %}
{% include '@provenza/layout/_menu-movil.html.twig' %}
<section class="marco marco--interior" style="--foto: url('{{ foto_cabecera }}')">
  <div class="marco__fondo"><div class="marco__foto"></div><div class="marco__velo"></div></div>
  {% include '@provenza/layout/_nav.html.twig' %}
  <div class="marco__titulo">
    {{ page.breadcrumb }}
    {{ page.header }}
  </div>
</section>
{% if page.highlighted %}<div class="contenedor destacado">{{ page.highlighted }}</div>{% endif %}
<main id="contenido" class="principal contenedor{{ page.sidebar ? ' principal--con-lateral' }}" tabindex="-1">
  <div class="principal__cuerpo">
    {{ page.content_above }}
    {{ page.content }}
    {{ page.content_below }}
  </div>
  {% if page.sidebar %}<aside class="principal__lateral" role="complementary">{{ page.sidebar }}</aside>{% endif %}
</main>
{% include '@provenza/layout/_footer.html.twig' %}
