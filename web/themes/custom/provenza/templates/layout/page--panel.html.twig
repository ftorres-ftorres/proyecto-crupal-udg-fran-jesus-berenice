<a href="#contenido" class="visually-hidden focusable saltar">Saltar al contenido</a>
{% include '@provenza/layout/_alerta.html.twig' %}
{% include '@provenza/layout/_barra.html.twig' with { fija: true } %}
{% include '@provenza/layout/_menu-movil.html.twig' %}
<div class="panel">
  <aside class="panel__lateral" aria-label="Mi panel">
    <div class="panel__usuario">
      <span class="panel__avatar" aria-hidden="true">{{ nombre_corto|first|upper }}</span>
      <span><strong>{{ nombre_usuario }}</strong><small>Colono de Provenza</small></span>
    </div>
    <nav class="panel__nav">
      <ul>
        {% for item in panel_nav %}
          <li><a href="{{ item.url }}"{{ item.activo ? ' class="es-activo" aria-current="page"' }}>{{ source('@provenza/icons/' ~ item.icono ~ '.svg') }}{{ item.titulo }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <a class="panel__salir" href="{{ path('user.logout') }}">{{ source('@provenza/icons/entrar.svg') }}Cerrar sesión</a>
  </aside>
  <main id="contenido" class="panel__contenido" tabindex="-1">
    {% if not es_resumen %}
    <div class="panel__cabeza">
      {{ page.breadcrumb }}
      {{ page.header }}
    </div>
    {% endif %}
    {{ page.highlighted }}
    <div class="panel__cuerpo{{ ayuda_formulario ? ' panel__cuerpo--ayuda' }}">
      <div>
        {{ page.content_above }}
        {{ page.content }}
      </div>
      {% if ayuda_formulario %}
        <aside class="ayuda">
          <h2>Qué pasa después</h2>
          <ol class="ayuda__pasos">{% for paso in ayuda_formulario %}<li><span>{{ loop.index }}</span>{{ paso }}</li>{% endfor %}</ol>
          <p class="ayuda__nota">¿Es urgente? Llama a caseta desde <a href="/seguridad/telefonos-de-emergencia">Teléfonos de emergencia</a>.</p>
        </aside>
      {% endif %}
    </div>
  </main>
</div>
