<a href="#contenido" class="visually-hidden focusable saltar">Saltar al contenido</a>
{% include '@provenza/layout/_vidrio.html.twig' %}
{% include '@provenza/layout/_alerta.html.twig' %}
<div class="app">
  <header class="app__barra">
    {% include '@provenza/layout/_marca.html.twig' %}
    <div class="app__usuario">
      <a class="icono-boton" href="/buscar" aria-label="Buscar">{{ source('@provenza/icons/buscar.svg') }}</a>
      <a class="app__perfil" href="/cuenta/mi-domicilio">
        <span class="app__avatar" aria-hidden="true">{{ nombre_corto|first|upper }}</span>
        <span class="app__nombre">{{ nombre_usuario }}</span>
      </a>
      <a class="icono-boton" href="{{ path('user.logout') }}" aria-label="Cerrar sesión"><span class="app__salir">{{ source('@provenza/icons/entrar.svg') }}</span></a>
    </div>
  </header>
  <main id="contenido" class="app__contenido" tabindex="-1">
    {% if not es_resumen %}
      <div class="app__cabeza">
        {{ page.header }}
      </div>
    {% endif %}
    {{ page.highlighted }}
    <div class="app__cuerpo{{ ayuda_formulario ? ' app__cuerpo--ayuda' }}">
      <div class="app__principal">
        {{ page.content_above }}
        {{ page.content }}
      </div>
      {% if ayuda_formulario %}
        <aside class="ayuda">
          <h2>Qué pasa después</h2>
          <ol class="ayuda__pasos">{% for paso in ayuda_formulario %}<li><span>{{ loop.index }}</span>{{ paso }}</li>{% endfor %}</ol>
          <p class="ayuda__nota">¿Es urgente? Llama a caseta desde <a href="/seguridad/telefonos-de-emergencia">Teléfonos de emergencia</a>.</p>
        </aside>
      {% endif %}
    </div>
  </main>
  <nav class="dock" aria-label="Mi panel">
    <ul>
      {% for item in panel_nav %}
        <li>
          <a class="dock__item{{ item.activo ? ' es-activo' }}" href="{{ item.url }}"{{ item.activo ? ' aria-current="page"' }}>
            {{ source('@provenza/icons/' ~ item.icono ~ '.svg') }}
            <span class="dock__texto">{{ item.titulo }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</div>
