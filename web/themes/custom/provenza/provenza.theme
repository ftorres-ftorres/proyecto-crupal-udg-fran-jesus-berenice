<?php

/**
 * @file
 * Funciones de preprocesamiento del tema Provenza.
 */

use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;

/**
 * Foto editada por código de instalación (carpeta images/fotos del tema).
 */
function provenza_facility_photo(?string $code, bool $small = FALSE): string {
  $map = [
    'salon' => 'salon',
    'gym' => 'gimnasio',
    'gimnasio' => 'gimnasio',
    'alberca' => 'alberca',
    'trotapista' => 'trotapista',
    'juegos' => 'juegos',
    'fuentes' => 'fuentes',
    'jardines' => 'jardines',
  ];
  $file = $map[$code] ?? 'amenidades';
  $base = \Drupal::service('extension.list.theme')->getPath('provenza');
  return base_path() . $base . '/images/fotos/' . $file . ($small ? '-sm' : '') . '.webp';
}

/**
 * Implements hook_preprocess_html().
 */
function provenza_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName() ?? '';
  $variables['attributes']['class'][] = 'ruta--' . str_replace(['.', '_'], '-', $route);
  $variables['attributes']['class'][] = 'pagina--' . provenza_page_kind();
  if (str_starts_with(\Drupal::service('path.current')->getPath(), '/asi-lo-construimos')) {
    $variables['attributes']['class'][] = 'es-tutorial';
  }
}

/**
 * Rutas que se muestran dentro del panel del colono.
 */
function provenza_panel_routes(): array {
  return [
    'provenza_core.panel', 'provenza_core.mis_solicitudes', 'provenza_core.mis_quejas',
    'provenza_core.mis_reservaciones', 'provenza_core.mis_autorizaciones', 'provenza_core.mis_vehiculos',
    'provenza_core.mi_domicilio', 'provenza_core.notificaciones', 'provenza_core.seguridad',
    'provenza_core.reporte_confidencial', 'provenza_core.qr', 'provenza_core.mis_asignaciones',
    'entity.webform.canonical', 'entity.webform.confirmation', 'entity.user.edit_form',
  ];
}

/**
 * Tipo de página: portada, panel, acceso (login) o interior.
 */
function provenza_page_kind(): string {
  $route = \Drupal::routeMatch()->getRouteName() ?? '';
  if (\Drupal::service('path.matcher')->isFrontPage() || $route === 'provenza_core.home') {
    return 'portada';
  }
  if (in_array($route, ['user.login', 'user.register', 'user.pass', 'user.reset.form'], TRUE)) {
    return 'acceso';
  }
  if (in_array($route, provenza_panel_routes(), TRUE) && \Drupal::currentUser()->isAuthenticated()) {
    return 'panel';
  }
  return 'interior';
}

/**
 * Implements hook_preprocess_page().
 */
function provenza_preprocess_page(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName() ?? '';
  $tema = base_path() . \Drupal::service('extension.list.theme')->getPath('provenza');
  $kind = provenza_page_kind();
  $variables['tipo_pagina'] = $kind;
  $variables['es_portada'] = $kind === 'portada';
  $variables['ruta_tema'] = $tema;
  $variables['video_hero'] = $tema . '/media/provenza-hero.mp4';
  $variables['poster_hero'] = $tema . '/media/provenza-hero-poster.webp';
  $variables['anio'] = date('Y');

  $account = \Drupal::currentUser();
  $variables['logueado'] = $account->isAuthenticated();
  $nombre = '';
  if ($account->isAuthenticated()) {
    $user = \Drupal\user\Entity\User::load($account->id());
    $nombre = $user && $user->hasField('field_nombre_completo') && !$user->get('field_nombre_completo')->isEmpty()
      ? (string) $user->get('field_nombre_completo')->value
      : $account->getDisplayName();
  }
  $variables['nombre_usuario'] = $nombre;
  $variables['nombre_corto'] = $nombre ? strtok($nombre, ' ') : '';
  $variables['url_entrar'] = Url::fromRoute('user.login', [], ['query' => ['destination' => '/mi-panel']])->toString();
  $variables['#cache']['contexts'][] = 'user';
  $variables['#cache']['contexts'][] = 'url.path';
  $variables['#cache']['tags'][] = 'node_list:aviso';
  $variables['#cache']['tags'][] = 'config:system.menu.main';
  $variables['menu_links'] = provenza_main_menu_links();
  $variables['es_resumen'] = $route === 'provenza_core.panel';

  // Avisos urgentes: se muestran como alerta en la parte superior.
  $variables['alertas'] = [];
  $nids = \Drupal::entityTypeManager()->getStorage('node')->getQuery()->accessCheck(TRUE)
    ->condition('type', 'aviso')->condition('status', 1)->condition('field_urgente', 1)
    ->sort('created', 'DESC')->range(0, 1)->execute();
  foreach (Node::loadMultiple($nids) as $aviso) {
    $texto = trim(strip_tags((string) $aviso->get('body')->value));
    $variables['alertas'][] = [
      'id' => 'aviso-' . $aviso->id() . '-' . $aviso->getChangedTime(),
      'titulo' => $aviso->label(),
      'resumen' => mb_strimwidth($texto, 0, 90, '…'),
      'url' => $aviso->toUrl()->toString(),
    ];
  }

  if ($kind === 'panel') {
    $variables['panel_nav'] = \Drupal\provenza_core\Controller\PanelController::navigation();
    $webform = \Drupal::routeMatch()->getParameter('webform');
    if ($webform && ($pasos = provenza_form_help($webform->id()))) {
      $variables['ayuda_formulario'] = $pasos;
    }
    return;
  }
  if ($kind === 'acceso') {
    $textos = [
      'user.login' => ['Bienvenido de vuelta', 'Entra con el correo que registraste con Administración.'],
      'user.register' => ['Solicita tu alta', 'Administración revisa tu número de casa y te confirma por correo.'],
      'user.pass' => ['Recupera tu acceso', 'Te enviamos un enlace para crear una contraseña nueva.'],
      'user.reset.form' => ['Crea tu contraseña', 'Un paso más y entras a tu panel.'],
    ];
    [$variables['acceso_titulo'], $variables['acceso_texto']] = $textos[$route] ?? $textos['user.login'];
    $variables['acceso_ruta'] = $route;
    return;
  }

  // Imagen de cabecera por sección para las páginas interiores.
  $path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);
  $secciones = [
    '/instalaciones' => 'amenidades',
    '/seguridad' => 'acceso',
    '/solicitudes' => 'alumbrado',
    '/quejas' => 'casas',
    '/comunidad' => 'casas',
    '/contacto' => 'fuentes',
    '/asi-lo-construimos' => 'jardines',
    '/buscar' => 'hero',
    '/mapa-del-sitio' => 'hero',
  ];
  $foto = 'hero';
  foreach ($secciones as $prefijo => $archivo) {
    if (str_starts_with($alias, $prefijo)) {
      $foto = $archivo;
    }
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && $node->bundle() === 'instalacion' && $node->hasField('field_codigo_instalacion')) {
    $variables['foto_cabecera'] = provenza_facility_photo($node->get('field_codigo_instalacion')->value);
  }
  elseif ($node instanceof NodeInterface && in_array($node->bundle(), ['aviso', 'evento'], TRUE)) {
    $variables['foto_cabecera'] = provenza_aviso_photo($node->label() . ' ' . strip_tags((string) $node->get('body')->value));
  }
  else {
    $variables['foto_cabecera'] = $tema . '/images/fotos/' . $foto . '.webp';
  }
}

/**
 * Implements hook_preprocess_provenza_home().
 */
function provenza_preprocess_provenza_home(array &$variables): void {
  $tema = base_path() . \Drupal::service('extension.list.theme')->getPath('provenza');
  $variables['ruta_tema'] = $tema;
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  // Instalaciones con su foto editada.
  $nids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'instalacion')->condition('status', 1)->execute();
  $orden = ['alberca', 'salon', 'gym', 'trotapista', 'juegos', 'jardines', 'fuentes'];
  $instalaciones = [];
  foreach (Node::loadMultiple($nids) as $node) {
    $code = $node->hasField('field_codigo_instalacion') ? (string) $node->get('field_codigo_instalacion')->value : '';
    $instalaciones[] = [
      'titulo' => $node->label(),
      'url' => $node->toUrl()->toString(),
      'foto' => provenza_facility_photo($code),
      'horario' => $node->hasField('field_horarios') ? str_replace('–', ' a ', (string) $node->get('field_horarios')->value) : '',
      'capacidad' => $node->hasField('field_capacidad') ? (int) $node->get('field_capacidad')->value : 0,
      'descripcion' => $node->hasField('body') ? trim(strip_tags((string) $node->get('body')->value)) : '',
      'peso' => array_search($code, $orden, TRUE) === FALSE ? 99 : array_search($code, $orden, TRUE),
    ];
  }
  usort($instalaciones, fn ($a, $b) => $a['peso'] <=> $b['peso']);
  $variables['instalaciones'] = $instalaciones;

  // Avisos recientes.
  $nids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'aviso')->condition('status', 1)
    ->sort('created', 'DESC')->range(0, 3)->execute();
  $avisos = [];
  foreach (Node::loadMultiple($nids) as $node) {
    $cuerpo = $node->hasField('body') ? strip_tags((string) $node->get('body')->value) : '';
    $avisos[] = [
      'titulo' => $node->label(),
      'url' => $node->toUrl()->toString(),
      'fecha' => \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'j \d\e F'),
      'resumen' => mb_strimwidth($cuerpo, 0, 120, '…'),
      'urgente' => $node->hasField('field_urgente') && (bool) $node->get('field_urgente')->value,
      'foto' => provenza_aviso_photo($node->label() . ' ' . $cuerpo),
    ];
  }
  $variables['avisos'] = $avisos;

  // Próximos eventos con fecha separada para la tarjeta.
  $nids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'evento')->condition('status', 1)
    ->sort('field_fecha_evento', 'ASC')->range(0, 4)->execute();
  $eventos = [];
  $formatter = \Drupal::service('date.formatter');
  foreach (Node::loadMultiple($nids) as $node) {
    $ts = $node->hasField('field_fecha_evento') && !$node->get('field_fecha_evento')->isEmpty() ? (int) $node->get('field_fecha_evento')->value : NULL;
    $eventos[] = [
      'titulo' => $node->label(),
      'url' => $node->toUrl()->toString(),
      'dia' => $ts ? $formatter->format($ts, 'custom', 'j', 'America/Mexico_City') : '',
      'mes' => $ts ? mb_substr($formatter->format($ts, 'custom', 'F', 'America/Mexico_City'), 0, 3) : '',
      'hora' => $ts ? $formatter->format($ts, 'custom', 'l, H:i', 'America/Mexico_City') . ' h' : '',
      'lugar' => $node->hasField('field_ubicacion') ? (string) $node->get('field_ubicacion')->value : '',
      'foto' => provenza_aviso_photo($node->label() . ' ' . ($node->hasField('body') ? strip_tags((string) $node->get('body')->value) : '')),
    ];
  }
  $variables['eventos'] = $eventos;

  // Cuota principal y tarifas destacadas.
  $nids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'tarifa')->condition('status', 1)->sort('title')->execute();
  $tarifas = [];
  foreach (Node::loadMultiple($nids) as $node) {
    $tarifas[] = [
      'concepto' => $node->label(),
      'monto' => $node->hasField('field_monto') ? number_format((float) $node->get('field_monto')->value, 0, '.', ',') : '',
    ];
  }
  $variables['tarifas'] = array_slice($tarifas, 0, 5);
  $variables['acciones'] = \Drupal\provenza_core\Controller\PanelController::actions();
  $variables['url_registro'] = Url::fromRoute('user.register')->toString();
  $variables['#cache']['tags'][] = 'node_list';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function provenza_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $kind = provenza_page_kind();
  if ($kind === 'portada') {
    $suggestions[] = 'page__front';
  }
  elseif ($kind === 'panel') {
    $suggestions[] = 'page__panel';
  }
  elseif ($kind === 'acceso') {
    $suggestions[] = 'page__acceso';
  }
}

/**
 * Implements hook_preprocess_provenza_listing().
 */
function provenza_preprocess_provenza_listing(array &$variables): void {
  if ($variables['bundle'] === 'evento') {
    $eventos = provenza_eventos();
    $proximos = array_values(array_filter($eventos, fn ($e) => $e['proximo']));
    $mes = \Drupal::request()->query->get('mes');
    if (!$mes || !preg_match('/^\d{4}-\d{2}$/', $mes)) {
      $mes = $proximos ? substr($proximos[0]['fecha'], 0, 7) : date('Y-m');
    }
    $variables['calendario'] = [
      'destacado' => $proximos[0] ?? NULL,
      'proximos' => array_slice($proximos, 0, 6),
      'mes' => provenza_mes($eventos, $mes),
    ];
    $variables['#cache']['contexts'][] = 'url.query_args:mes';
  }
  if ($variables['bundle'] === 'instalacion') {
    foreach ($variables['items'] as &$item) {
      $item['foto'] = provenza_facility_photo($item['codigo'] ?? NULL, TRUE);
    }
    unset($item);
    $orden = ['alberca', 'salon', 'gym', 'trotapista', 'juegos', 'jardines', 'fuentes'];
    usort($variables['items'], fn ($a, $b) => (array_search($a['codigo'], $orden, TRUE) ?: 0) <=> (array_search($b['codigo'], $orden, TRUE) ?: 0));
    $variables['items'][0]['foto'] = provenza_facility_photo($variables['items'][0]['codigo']);
  }
}

/**
 * Implements hook_preprocess_node().
 */
function provenza_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $variables['fecha_bonita'] = \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'j \d\e F \d\e Y', 'America/Mexico_City');
  if ($variables['view_mode'] === 'full' && $node->bundle() === 'aviso') {
    $variables['aviso'] = [
      'texto' => trim(strip_tags((string) $node->get('body')->value)),
      'categoria' => $node->get('field_categoria_aviso')->entity?->label() ?? '',
      'urgente' => (bool) $node->get('field_urgente')->value,
      'fecha' => $variables['fecha_bonita'],
    ];
    $variables['proximos'] = array_slice(array_values(array_filter(provenza_eventos(), fn ($e) => $e['proximo'])), 0, 3);
    $otros = [];
    $nids = \Drupal::entityTypeManager()->getStorage('node')->getQuery()->accessCheck(TRUE)
      ->condition('type', 'aviso')->condition('status', 1)->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')->range(0, 3)->execute();
    foreach (Node::loadMultiple($nids) as $o) {
      $otros[] = ['titulo' => $o->label(), 'url' => $o->toUrl()->toString(), 'foto' => provenza_aviso_photo($o->label() . ' ' . strip_tags((string) $o->get('body')->value))];
    }
    $variables['otros_avisos'] = $otros;
    $variables['#cache']['tags'][] = 'node_list';
    return;
  }
  if ($variables['view_mode'] === 'full' && $node->bundle() === 'evento') {
    $todos = provenza_eventos();
    foreach ($todos as $e) {
      if ($e['id'] === (int) $node->id()) {
        $variables['evento'] = $e + ['ics' => provenza_ics($e), 'texto' => trim(strip_tags((string) $node->get('body')->value))];
      }
    }
    $variables['proximos'] = array_slice(array_values(array_filter($todos, fn ($e) => $e['proximo'] && $e['id'] !== (int) $node->id())), 0, 3);
    $variables['#cache']['tags'][] = 'node_list';
    return;
  }
  if ($node->bundle() !== 'instalacion' || $variables['view_mode'] !== 'full') {
    return;
  }
  $code = (string) $node->get('field_codigo_instalacion')->value;
  $variables['ficha'] = [
    'codigo' => $code,
    'descripcion' => strip_tags((string) $node->get('body')->value),
    'horario' => str_replace('–', ' a ', (string) $node->get('field_horarios')->value),
    'capacidad' => (int) $node->get('field_capacidad')->value,
    'foto' => provenza_facility_photo($code),
    'reglas' => provenza_split_lines((string) $node->get('field_reglas')->value),
    'tarifas' => [],
  ];
  foreach ($node->get('field_tarifa')->referencedEntities() as $tarifa) {
    $variables['ficha']['tarifas'][] = [
      'concepto' => $tarifa->label(),
      'monto' => number_format((float) $tarifa->get('field_monto')->value, 0, '.', ','),
    ];
  }
  $acciones = [];
  if ($code === 'salon') {
    $acciones[] = ['titulo' => 'Ver disponibilidad', 'url' => '/instalaciones/salon-de-fiestas/calendario', 'icono' => 'calendario', 'principal' => TRUE];
    $acciones[] = ['titulo' => 'Solicitar reservación', 'url' => '/form/reservar-salon', 'icono' => 'fiesta'];
  }
  $acciones[] = ['titulo' => 'Reportar un problema', 'url' => '/form/solicitud-servicio', 'icono' => 'solicitud', 'principal' => $code !== 'salon'];
  $variables['ficha']['acciones'] = $acciones;
}

/**
 * Implements hook_theme_suggestions_field_alter().
 */
function provenza_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $node = $variables['elements']['#node'] ?? NULL;
  if ($node && $node->bundle() === 'instalacion' && ($variables['elements']['#view_mode'] ?? '') === 'full') {
    $suggestions[] = 'node__instalacion__ficha';
  }
}

/**
 * Convierte un texto con saltos de línea o párrafos en una lista limpia.
 */
function provenza_split_lines(string $html): array {
  $text = preg_replace('/<br\s*\/?>|<\/p>/i', "\n", $html);
  $lines = array_map(fn ($l) => trim(html_entity_decode(strip_tags($l))), explode("\n", $text));
  return array_values(array_filter($lines, fn ($l) => $l !== ''));
}

/**
 * Datos para tarjetas de las páginas de sección (centros de enlaces).
 */
