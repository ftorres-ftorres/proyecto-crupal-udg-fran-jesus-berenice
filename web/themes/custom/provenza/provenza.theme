/**
 * Implements hook_preprocess_node__page().
 */
function provenza_preprocess_node__page(array &$variables): void {
  if ($variables['view_mode'] !== 'full') {
    return;
  }
  $html = (string) $variables['node']->get('body')->value;
  if (!str_contains($html, '<ul>') || !str_contains($html, 'href="/')) {
    return;
  }
  $dom = new \DOMDocument();
  @$dom->loadHTML('<?xml encoding="utf-8"?><div>' . $html . '</div>');
  $xpath = new \DOMXPath($dom);
  $links = $xpath->query('//ul/li/a[starts-with(@href, "/")]');
  // Solo es centro de enlaces si cada elemento de la lista es un enlace interno.
  if (!$links->length || $links->length !== $xpath->query('//ul/li')->length) {
    return;
  }
  $meta = provenza_hub_meta();
  $tarjetas = [];
  foreach ($links as $a) {
    $href = $a->getAttribute('href');
    $tarjetas[] = [
      'titulo' => trim($a->textContent),
      'url' => $href,
      'icono' => $meta[$href][0] ?? 'flecha_diag',
      'texto' => $meta[$href][1] ?? '',
    ];
  }
  $intro = [];
  foreach ($xpath->query('/html/body/div/p') as $p) {
    $intro[] = trim($p->textContent);
  }
  $variables['hub'] = ['intro' => implode(' ', $intro), 'tarjetas' => $tarjetas];
}

/**
 * Textos de apoyo para la columna lateral de cada formulario.
 */
function provenza_form_help(string $id): ?array {
  $ayuda = [
    'solicitud_servicio' => ['Recibes un folio al enviar', 'Administración la revisa y la asigna a mantenimiento', 'Te avisamos por correo en cada cambio de estado', 'Cuando se resuelva, califica el servicio'],
    'recoleccion_especial' => ['Elige la fecha de recolección', 'Saca los residuos la noche anterior', 'Consulta el costo en Cuotas y tarifas'],
    'calificar_servicio' => ['Califica de 1 a 5 estrellas', 'Tu comentario ayuda a mejorar el servicio'],
    'queja_sugerencia' => ['Recibes un folio al enviar', 'Administración investiga y toma acción', 'Si marcas confidencial, solo Administración ve tu nombre', 'Lee la resolución en Mis quejas'],
    'reservar_salon' => ['Revisa antes las fechas libres en el calendario', 'Administración aprueba o rechaza la solicitud', 'El depósito en garantía se devuelve después del evento'],
    'registrar_visita' => ['Captura el nombre y la ventana de horario', 'Se genera un pase QR para compartir', 'Caseta valida el pase y registra entrada y salida'],
    'reportar_incidente' => ['Describe qué pasó y dónde', 'Agrega fotos si es seguro hacerlo', 'Ante una emergencia llama primero a caseta o al 911'],
  ];
  return $ayuda[$id] ?? NULL;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function provenza_form_user_login_form_alter(array &$form): void {
  $form['pass']['#suffix'] = '<a class="acceso__olvido" href="' . Url::fromRoute('user.pass')->toString() . '">¿Olvidaste tu contraseña?</a>';
  $form['actions']['submit']['#value'] = 'Entrar a mi panel';
}

/**
 * Foto editada que acompaña a un aviso según su tema.
 */
function provenza_aviso_photo(string $texto): string {
  $texto = mb_strtolower($texto);
  $mapa = ['asamblea' => 'salon', 'jard' => 'jardines', 'fumig' => 'jardines', 'alberca' => 'alberca', 'salón' => 'salon', 'salon' => 'salon', 'gimnasio' => 'gimnasio', 'luz' => 'alumbrado', 'alumbrado' => 'alumbrado', 'basura' => 'residuos', 'residuo' => 'residuos', 'acceso' => 'acceso', 'caseta' => 'acceso', 'agua' => 'fuentes'];
  foreach ($mapa as $clave => $foto) {
    if (str_contains($texto, $clave)) {
      return base_path() . \Drupal::service('extension.list.theme')->getPath('provenza') . '/images/fotos/' . $foto . '.webp';
    }
  }
  return base_path() . \Drupal::service('extension.list.theme')->getPath('provenza') . '/images/fotos/casas.webp';
}

/**
 * Enlaces del menú principal ya filtrados por acceso.
 */
function provenza_main_menu_links(): array {
  $tree_service = \Drupal::menuTree();
  $params = $tree_service->getCurrentRouteMenuTreeParameters('main');
  $params->setMaxDepth(1);
  $tree = $tree_service->load('main', $params);
  $tree = $tree_service->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);
  $links = [];
  $actual = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($actual);
  foreach ($tree as $element) {
    if (!$element->link->isEnabled() || ($element->access && !$element->access->isAllowed())) {
      continue;
    }
    $url = $element->link->getUrlObject()->toString();
    $links[] = [
      'titulo' => $element->link->getTitle(),
      'url' => $url,
      'activo' => $element->inActiveTrail || str_starts_with($alias, $url),
    ];
  }
  return $links;
}
/**
 * Eventos publicados con todos los datos que usa el tema, en orden de fecha.
 */
function provenza_eventos(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'evento')->condition('status', 1)
    ->sort('field_fecha_evento', 'ASC')->execute();
  $fmt = \Drupal::service('date.formatter');
  $tz = 'America/Mexico_City';
  $hoy = new \DateTimeImmutable('today', new \DateTimeZone($tz));
  $eventos = [];
  foreach (Node::loadMultiple($nids) as $node) {
    if ($node->get('field_fecha_evento')->isEmpty()) {
      continue;
    }
    $ts = (int) $node->get('field_fecha_evento')->value;
    $fin = (int) ($node->get('field_fecha_evento')->end_value ?? $ts + 3600);
    $dia = (new \DateTimeImmutable('@' . $ts))->setTimezone(new \DateTimeZone($tz))->setTime(0, 0);
    $faltan = (int) $hoy->diff($dia)->format('%r%a');
    $cuerpo = trim(strip_tags((string) $node->get('body')->value));
    $eventos[] = [
      'id' => (int) $node->id(),
      'titulo' => $node->label(),
      'url' => $node->toUrl()->toString(),
      'ts' => $ts,
      'fin' => $fin,
      'fecha' => $fmt->format($ts, 'custom', 'Y-m-d', $tz),
      'dia' => $fmt->format($ts, 'custom', 'j', $tz),
      'mes' => mb_substr($fmt->format($ts, 'custom', 'F', $tz), 0, 3),
      'mes_largo' => mb_strtolower($fmt->format($ts, 'custom', 'F', $tz)),
      'semana' => $fmt->format($ts, 'custom', 'l', $tz),
      'hora' => $fmt->format($ts, 'custom', 'H:i', $tz) . ' h',
      'hora_fin' => $fmt->format($fin, 'custom', 'H:i', $tz) . ' h',
      'lugar' => (string) $node->get('field_ubicacion')->value,
      'tipo' => $node->get('field_tipo_evento')->entity?->label() ?? '',
      'resumen' => mb_strimwidth($cuerpo, 0, 140, '…'),
      'foto' => provenza_aviso_photo($node->label() . ' ' . $cuerpo),
      'faltan' => $faltan,
      'cuando' => $faltan === 0 ? 'Hoy' : ($faltan === 1 ? 'Mañana' : ($faltan > 1 ? 'Faltan ' . $faltan . ' días' : 'Ya pasó')),
      'proximo' => $faltan >= 0,
    ];
  }
  return $eventos;
}

/**
 * Cuadrícula de un mes (lunes a domingo) con los eventos de cada día.
 */
function provenza_mes(array $eventos, string $ym): array {
  $tz = new \DateTimeZone('America/Mexico_City');
  $inicio = \DateTimeImmutable::createFromFormat('!Y-m', $ym, $tz) ?: new \DateTimeImmutable('first day of this month', $tz);
  $hoy = (new \DateTimeImmutable('now', $tz))->format('Y-m-d');
  $por_dia = [];
  foreach ($eventos as $e) {
    $por_dia[$e['fecha']][] = $e;
  }
  $celdas = [];
  for ($i = 1; $i < (int) $inicio->format('N'); $i++) {
    $celdas[] = ['vacio' => TRUE];
  }
  $dias = (int) $inicio->format('t');
  for ($d = 1; $d <= $dias; $d++) {
    $fecha = $inicio->setDate((int) $inicio->format('Y'), (int) $inicio->format('n'), $d)->format('Y-m-d');
    $celdas[] = ['dia' => $d, 'fecha' => $fecha, 'hoy' => $fecha === $hoy, 'eventos' => $por_dia[$fecha] ?? []];
  }
  $meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  return [
    'titulo' => ucfirst($meses[(int) $inicio->format('n') - 1]) . ' ' . $inicio->format('Y'),
    'celdas' => $celdas,
    'anterior' => $inicio->modify('-1 month')->format('Y-m'),
    'siguiente' => $inicio->modify('+1 month')->format('Y-m'),
  ];
}

/**
 * Enlace de descarga .ics para agregar un evento al calendario del teléfono.
 */
function provenza_ics(array $e): string {
  $f = fn (int $ts) => gmdate('Ymd\THis\Z', $ts);
  $ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Provenza Residencial//Portal de colonos//ES\r\nBEGIN:VEVENT\r\nUID:evento-" . $e['id'] . "@provenza\r\nDTSTAMP:" . $f(time()) . "\r\nDTSTART:" . $f($e['ts']) . "\r\nDTEND:" . $f($e['fin']) . "\r\nSUMMARY:" . $e['titulo'] . "\r\nLOCATION:" . ($e['lugar'] ?: 'Provenza Residencial') . ", Tlajomulco de Zúñiga\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n";
  return 'data:text/calendar;charset=utf-8,' . rawurlencode($ics);
}

/**
 * Implements hook_preprocess_provenza_calendar().
 */
function provenza_preprocess_provenza_calendar(array &$variables): void {
  $request = \Drupal::request();
  $tz = new \DateTimeZone('America/Mexico_City');
  $year = (int) ($request->query->get('y') ?: date('Y'));
  $month = (int) ($request->query->get('m') ?: date('n'));
  $hoy = (new \DateTimeImmutable('now', $tz))->format('Y-m-d');
  foreach ($variables['days'] as &$day) {
    if (!empty($day['empty'])) {
      continue;
    }
    $fecha = sprintf('%04d-%02d-%02d', $year, $month, $day['date']);
    $day['fecha'] = $fecha;
    $day['hoy'] = $fecha === $hoy;
    $day['pasado'] = $fecha < $hoy;
    $day['url'] = '/form/reservar-salon?fecha_inicio=' . $fecha . 'T18:00:00&fecha_fin=' . $fecha . 'T23:00:00';
  }
  unset($day);
  // Datos del salón para la tarjeta lateral.
  $variables['salon'] = NULL;
  $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'instalacion', 'field_codigo_instalacion' => 'salon']);
  if ($salon = reset($nodes)) {
    $tarifas = [];
    foreach ($salon->get('field_tarifa')->referencedEntities() as $t) {
      $tarifas[] = ['concepto' => $t->label(), 'monto' => number_format((float) $t->get('field_monto')->value, 0, '.', ',')];
    }
    $variables['salon'] = [
      'url' => $salon->toUrl()->toString(),
      'foto' => provenza_facility_photo('salon'),
      'capacidad' => (int) $salon->get('field_capacidad')->value,
      'horario' => str_replace('–', ' a ', (string) $salon->get('field_horarios')->value),
      'tarifas' => $tarifas,
    ];
  }
  $variables['#cache']['contexts'][] = 'url.query_args';
}

/**
 * Implements hook_preprocess_provenza_panel().
 */
function provenza_preprocess_provenza_panel(array &$variables): void {
  $tz = new \DateTimeZone('America/Mexico_City');
  $hoy = new \DateTimeImmutable('today', $tz);
  $eventos = provenza_eventos();
  $por_dia = [];
  foreach ($eventos as $e) {
    $por_dia[$e['fecha']][] = $e;
  }
  $nombres = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
  $semana = [];
  for ($i = 0; $i < 7; $i++) {
    $d = $hoy->modify("+$i day");
    $f = $d->format('Y-m-d');
    $semana[] = ['nombre' => $nombres[(int) $d->format('N') - 1], 'numero' => $d->format('j'), 'hoy' => $i === 0, 'evento' => !empty($por_dia[$f])];
  }
  $variables['semana'] = $semana;
  $variables['eventos_semana'] = array_values(array_filter($eventos, fn ($e) => $e['faltan'] >= 0 && $e['faltan'] < 7));
  $meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  $dias = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'];
  $variables['fecha_hoy'] = ucfirst($dias[(int) $hoy->format('N') - 1]) . ' ' . $hoy->format('j') . ' de ' . $meses[(int) $hoy->format('n') - 1];
  $variables['#cache']['tags'][] = 'node_list:evento';
}
