    '/comunidad/documentos' => ['documento', 'Reglamento interno, formatos y documentos oficiales.'],
    '/comunidad/actas' => ['grupo', 'Acuerdos de las asambleas de colonos.'],
    '/comunidad/preguntas-frecuentes' => ['ayuda', 'Respuestas rápidas a las dudas más comunes.'],
